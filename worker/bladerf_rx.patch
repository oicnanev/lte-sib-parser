 } rf_blade_handler_t;
 
 static srsran_rf_error_handler_t blade_error_handler     = NULL;
@@ -75,7 +76,7 @@ int rf_blade_start_tx_stream(void* h)
 
   status = bladerf_sync_config(handler->dev,
                                BLADERF_TX_X1,
-                               BLADERF_FORMAT_SC16_Q11_META,
+                               BLADERF_FORMAT_SC16_Q11, /* same format as RX (required); TX is never used */
                                num_buffers,
                                buffer_size_tx,
                                num_transfers,
@@ -98,42 +99,39 @@ int rf_blade_start_rx_stream(void* h, UNUSED bool now)
   int                 status;
   rf_blade_handler_t* handler = (rf_blade_handler_t*)h;
 
-  /* Configure the device's RX module for use with the sync interface.
-   * SC16 Q11 samples *with* metadata are used. */
-  uint32_t buffer_size_rx = ms_buffer_size_rx * (handler->rx_rate / 1000 / 1024);
-
+  /* Configure the device's RX module for use with the sync interface. */
+  /* lte-sib-parser: fixed 32768-sample USB buffers. The size was derived from
+   * the rate when the stream starts (1.92 MSPS): 1024 samples, ~30000 USB
+   * transfers per second at 30.72 MSPS. In an arm64 VM libbladeRF's stream
+   * thread spent 96% CPU submitting them and srsue kept losing the cell. */
+  const uint32_t     buffer_size_rx   = 32768;
+  const unsigned int num_buffers_rx   = 32;
+  const unsigned int num_transfers_rx = 16;
+
+  /* lte-sib-parser: RX without metadata. Reading SC16_Q11_META with
+   * BLADERF_META_FLAG_RX_NOW on every call dropped the samples buffered between
+   * calls on bladeRF 2.0 (libbladeRF 2.6, FPGA 0.16), reported as overruns, and
+   * srsue kept losing SFN sync. The stream is continuous; RX time is counted. */
+  handler->rx_samples = 0;
   status = bladerf_sync_config(handler->dev,
                                BLADERF_RX_X1,
-                               BLADERF_FORMAT_SC16_Q11_META,
-                               num_buffers,
+                               BLADERF_FORMAT_SC16_Q11,
+                               num_buffers_rx,
                                buffer_size_rx,
-                               num_transfers,
+                               num_transfers_rx,
                                timeout_ms);
   if (status != 0) {
     ERROR("Failed to configure RX sync interface: %s", bladerf_strerror(status));
     return status;
   }
-  status = bladerf_sync_config(handler->dev,
-                               BLADERF_TX_X1,
-                               BLADERF_FORMAT_SC16_Q11_META,
-                               num_buffers,
-                               buffer_size_tx,
-                               num_transfers,
-                               timeout_ms);
-  if (status != 0) {
-    ERROR("Failed to configure TX sync interface: %s", bladerf_strerror(status));
-    return status;
-  }
+  /* lte-sib-parser: the TX module is neither configured nor enabled here (it
+   * was, although the scan never transmits): it stays off, whatever is on the
+   * TX ports. */
   status = bladerf_enable_module(handler->dev, BLADERF_RX_X1, true);
   if (status != 0) {
     ERROR("Failed to enable RX module: %s", bladerf_strerror(status));
     return status;
   }
-  status = bladerf_enable_module(handler->dev, BLADERF_TX_X1, true);
-  if (status != 0) {
-    ERROR("Failed to enable TX module: %s", bladerf_strerror(status));
-    return status;
-  }
   handler->rx_stream_enabled = true;
   return 0;
 }
@@ -439,30 +437,28 @@ int rf_blade_recv_with_time(void*       h,
   int                     status;
 
   memset(&meta, 0, sizeof(meta));
-  meta.flags = BLADERF_META_FLAG_RX_NOW;
 
-  if (2 * nsamples > CONVERT_BUFFER_SIZE) {
-    ERROR("RX failed: nsamples exceeds buffer size (%d>%d)", nsamples, CONVERT_BUFFER_SIZE);
-    return -1;
-  }
-  status = bladerf_sync_rx(handler->dev, handler->rx_buffer, nsamples, &meta, 2000);
-  if (status) {
-    ERROR("RX failed: %s; nsamples=%d;", bladerf_strerror(status), nsamples);
-    return -1;
-  } else if (meta.status & BLADERF_META_STATUS_OVERRUN) {
-    if (blade_error_handler) {
-      srsran_rf_error_t error;
-      error.opt  = meta.actual_count;
-      error.type = SRSRAN_RF_ERROR_OVERFLOW;
-      blade_error_handler(blade_error_handler_arg, error);
-    } else {
-      /*ERROR("Overrun detected in scheduled RX. "
-            "%u valid samples were read.", meta.actual_count);*/
+  /* read in pieces that fit the conversion buffer: with a fixed hardware rate
+   * (--rf.srate) the radio asks for up to 16x more samples per call than the
+   * decimated rate, e.g. 153600 for 5 ms of cell search at 30.72 MSPS */
+  uint32_t done = 0;
+  while (done < nsamples) {
+    uint32_t n = nsamples - done;
+    if (2 * n > CONVERT_BUFFER_SIZE) {
+      n = CONVERT_BUFFER_SIZE / 2;
+    }
+    status = bladerf_sync_rx(handler->dev, handler->rx_buffer, n, NULL, 2000);
+    if (status) {
+      ERROR("RX failed: %s; nsamples=%d;", bladerf_strerror(status), n);
+      return -1;
     }
+    srsran_vec_convert_if(handler->rx_buffer, 2048, (float*)data + 2 * done, 2 * n);
+    done += n;
   }
 
+  meta.timestamp = handler->rx_samples;
+  handler->rx_samples += nsamples;
   timestamp_to_secs(handler->rx_rate, meta.timestamp, secs, frac_secs);
-  srsran_vec_convert_if(handler->rx_buffer, 2048, data, 2 * nsamples);
 
   return nsamples;
 }
